$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 820);

    #Title {
      Label #TitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "NonSinns Montagebank";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Hint {
        Anchor: (Bottom: 12);
        Style: (...$C.@DefaultLabelStyle, TextColor: #cdbb9c, HorizontalAlignment: Center, Wrap: true);
        Text: "Bauteil rechts wählen: mit Werkzeug montieren oder einzeln zerlegen.";
      }

      Group #AssemblySlots {
        LayoutMode: Left;
        Anchor: (Height: 108, Bottom: 8);

        Group { FlexWeight: 1; }
        Group {
          LayoutMode: Top;
          Anchor: (Width: 130);
          Label { Anchor: (Bottom: 5); Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center); Text: "WERKZEUG"; }
          ItemGrid #ToolSlot {
            Anchor: (Width: 76, Height: 76);
            SlotsPerRow: 1;
            Style: (SlotSize: 76, SlotIconSize: 68, SlotSpacing: 0, SlotBackground: "../Common/BlockSelectorSlotBackground.png");
          }
        }
        Label { Anchor: (Width: 70); Style: (...$C.@TitleStyle, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+"; }
        Group {
          LayoutMode: Top;
          Anchor: (Width: 130);
          Label { Anchor: (Bottom: 5); Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center); Text: "BAUTEIL"; }
          ItemGrid #ModuleSlot {
            Anchor: (Width: 76, Height: 76);
            SlotsPerRow: 1;
            Style: (SlotSize: 76, SlotIconSize: 68, SlotSpacing: 0, SlotBackground: "../Common/BlockSelectorSlotBackground.png");
          }
        }
        Group { FlexWeight: 1; }
      }

      Label #Status {
        Anchor: (Height: 72, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, TextColor: #e5d4b2, HorizontalAlignment: Center, Wrap: true);
        Text: "Links ein Werkzeug aus dem Inventar auswählen.";
      }

      Group #Actions {
        LayoutMode: Left;
        Anchor: (Height: 46, Bottom: 14);

        Group { FlexWeight: 1; }
        $C.@TextButton #Combine {
          Anchor: (Width: 150, Height: 46, Right: 4);
          Text: "Kombinieren";
          Disabled: true;
        }
        $C.@TextButton #Repair {
          Anchor: (Width: 190, Height: 46, Right: 4, Left: 4);
          Text: "Reparieren";
          Disabled: true;
        }
        $C.@TextButton #Fuse {
          Anchor: (Width: 190, Height: 46, Right: 4, Left: 4);
          Text: "Aufwerten";
          Disabled: true;
        }
        $C.@TextButton #Recycle {
          Anchor: (Width: 150, Height: 46, Left: 4);
          Text: "Bauteil zerlegen";
          Disabled: true;
        }
        Group { FlexWeight: 1; }
      }

      Group #InventoryColumns {
        LayoutMode: Left;
        Anchor: (Height: 270);

        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 8);
          Label { Anchor: (Bottom: 7); Style: (...$C.@DefaultLabelStyle, TextColor: #66ddff); Text: "Werkzeuge im Inventar"; }
          Group {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            FlexWeight: 1;
            Group #ToolChoices { LayoutMode: Top; }
            Label #NoTools { Style: (...$C.@DefaultLabelStyle, TextColor: #8e826f, Wrap: true); Text: "Kein Bergbauhammer und keine Flächenschaufel gefunden."; }
          }
        }

        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Left: 8);
          Label { Anchor: (Bottom: 7); Style: (...$C.@DefaultLabelStyle, TextColor: #d98cff); Text: "Bauteile im Inventar"; }
          Group {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            FlexWeight: 1;
            Group #ModuleChoices { LayoutMode: Top; }
            Label #NoModules { Style: (...$C.@DefaultLabelStyle, TextColor: #8e826f, Wrap: true); Text: "Keine kalibrierten Resonanzbauteile gefunden."; }
          }
        }
      }
    }
  }
}

$C.@BackButton {}
